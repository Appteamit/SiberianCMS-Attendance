<link href="/app/sae/design/desktop/flat/js/dynatable/jquery.dynatable.css"
      media="screen"
      rel="stylesheet"
      type="text/css">
<script type="text/javascript"
        src="/app/sae/design/desktop/flat/js/dynatable/jquery.dynatable.js"></script>

<style type="text/css">
    #dynamic-leaves {
        margin-top: 15px;
    }
</style>

<script type="text/javascript">
    var uriParams = {};
    let rowTemplate = `
    <tr class="dynarow">
        <td>#(ID)</td>
        <td>(NAME)</td>
        <td>
            <a target="_blank" btn btn-xs btn-default" href="/attendance/locations/qrcode/value_id/(VALUEID)/id/(ID)">
             <i class="fa fa-qrcode" aria-hidden="true"></i>
            </a>
        </td>
        <td>(STATUS)</td>
        <td>(ALLOW)</td>
        <td>(DATE)</td>       
        <td>
           <a href="/attendance/locations/members/id/(ID)"
               class="btn btn-xs btn-primary members-location (IS_MEMBER)">
                <?php echo __js("MEMBERS") ?>
            </a>
           <a href="/attendance/locations/edit/id/(ID)"
               class="btn btn-xs btn-info edit-location">
                <?php echo __js("EDIT") ?>
            </a>
            <a href="/attendance/locations/delete/id/(ID)"
               class="btn btn-xs btn-danger delete-location">
                <?php echo __js("DELETE") ?>
            </a>
        </td>
     </tr>`;

    function rowWriter(rowIndex, record, columns, cellWriter) {
        return rowTemplate
            .replace(/\(ID\)/g, record.id)
            .replace(/\(NAME\)/g, record.name)
            .replace(/\(QR\)/g, record.qr_code)
            .replace(/\(DATE\)/g, record.created_at)
            .replace(/\(VALUEID\)/g, record.value_id)
            .replace(/\(ALLOW\)/g, record.allow_scan)
            .replace(/\(IS_MEMBER\)/g, record.is_member)
            .replace(/\(STATUS\)/g, record.status);
    }
    $.dynatableSetup({
        table: {
            defaultColumnIdStyle: 'noStyle'
        },
        features: {
            paginate: true,
            sort: true,
            pushState: true,
            search: true,
            recordCount: true,
            perPageSelect: false,
        },
    });

    let tableCustomers = $('#dynamic-locations');

    tableCustomers.bind('dynatable:preinit', function(e, dynatable) {
        dynatable.utility.textTransform.noStyle = function(text) {
            return text;
        };
    });
  
 
    tableCustomers.bind('dynatable:afterProcess', function (e, data) {
        uriParams = data.queries;
    });
    

    tableCustomers.bind('dynatable:push', function(e, dynatable) {
          uriParams = dynatable.queries;   
    });

    // And on the table attendance/leave/list
    tableCustomers.dynatable({
        dataset: {
            ajax: true,
            ajaxUrl: '/attendance/locations/fetch-all',
            ajaxOnLoad: true,
            records: [],
            perPageDefault: 25
        },
        inputs: {
            processingText: '<?php echo __jss("Loading ...") ?>',
            searchPlaceholder: '<?php echo __jss("Search by name ...") ?>',
            recordCountText: '<?php echo __jss("Showing") ?> ',
            filteredFrom: ' (<?php echo __jss("filtered from #TOTAL# total records") ?>)',
            recordText: '<?php echo __jss("record") ?>',
            recordTextPlural: '<?php echo __jss("records") ?>',
            textOf: '<?php echo __jss("of") ?>',
            textTo: '<?php echo __jss("to") ?>',
            queries: $('.dt-search')
        },
        writers: {
            _rowWriter: rowWriter
        }
    });

    $(document).ready(function() {
        if($.datepicker.regional['<?php echo Core_Model_Language::getCurrentLanguageDatepicker(); ?>']) {
            $.datepicker.setDefaults($.datepicker.regional['<?php echo Core_Model_Language::getCurrentLanguageDatepicker(); ?>']);
        } else {
            $.datepicker.setDefaults($.datepicker.regional['en']);
        }
    });


    $(document).off("click", ".delete-location");
    $(document).on("click", ".delete-location", function (e) {
        e.preventDefault();
        let deleteHref = $(this).attr("href");
        swal({
            title: '<?php echo P__("attendance", "Confirmation") ?>',
            text: '<?php echo P__("attendance", "Are you sure you want to delete this QRCode?") ?>',
            showCancelButton: true,
            confirmButtonColor: '#0099C7',
            confirmButtonText: '<?php echo P__("attendance", "Yes, delete!")?>',
            cancelButtonText: '<?php echo P__("attendance", "No, go back") ?>',
            buttons: true
        }, function(value) {
            if (!value) {
                return false;
            }

            formget(deleteHref,
                {},
                function (data) {
                    feature_form_success(data.message);
                   // Reload only on success and when done!
                    setTimeout(function () {
                        location.reload();
                    }, 1500)
                },
                function (data) {
                    feature_form_error(JSON.parse(data.responseText).message);
                },
                false);
        });
    });

</script>
 